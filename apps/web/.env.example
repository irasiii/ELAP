# Copy this file to .env.local and fill in the values you need.
# .env.local is ignored by git; never commit real keys.

# API-Football key from https://www.api-football.com (free plan: 100 requests/day).
# Leave empty to run the site with sample data.
API_FOOTBALL_KEY=

# Optional: show every competition API-Football returns, instead of ELAP's curated list.
# ELAP_SHOW_ALL_LEAGUES=1
